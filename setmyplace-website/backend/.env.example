# Copy this file to .env.local and fill in real values, or just export
# these as environment variables directly. main.go reads them with
# os.Getenv — plain env vars, no .env-loading library involved.

DATABASE_URL=postgres://setmyplace:setmyplace@localhost:5432/setmyplace?sslmode=disable
PORT=8080
ADMIN_KEY=change-this-to-a-long-random-string
